---

<Layout
  title={__("GatoSports Collectie | Hardloopkleding & Sportkleding")}
  description={__("Ontdek de GatoSports collectie. Hoogwaardige hardloopkleding en sportkleding met reflecterende details. Duurzaam, comfortabel en veilig.")}
>
  <main>
    <!-- Hero Section -->
    <section class="container py-10 sm:py-20">
      <div class="text-center mb-12">
        <h1 class="text-h2 sm:text-h1 mb-4 font-medium animate-slide-in">
          {__("GatoSports Collectie")}
        </h1>
        <p class="text-muted-foreground max-w-[640px] mx-auto text-lg animate-slide-in animation-delay-100">
          {__("Ontdek alle 45 producten uit onze GatoSports collectie. Van hardloopkleding tot accessoires en medische ondersteuning.")}
        </p>
      </div>

      <!-- Product Grid - 4 per row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-[1400px] mx-auto">
        {
          products.map((product) => (
            <div class="group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col">
              <!-- Square Image Container -->
              <div class="aspect-square overflow-hidden bg-gray-50">
                <img
                  src={product.image}
                  alt={product.name}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
              </div>
              
              <!-- Product Info - flex-grow pushes buttons to bottom -->
              <div class="p-4 flex flex-col flex-grow">
                <h3 class="text-lg font-semibold mb-1.5 leading-tight">{product.name}</h3>
                <p class="text-muted-foreground text-sm mb-3 flex-grow leading-relaxed">{product.description}</p>
                
                <!-- Button Group - stays at bottom -->
                <div class="flex gap-2 mt-auto">
                  <a
                    href="https://www.gatosports.com"
                    class="flex-1 inline-flex items-center justify-center px-3 py-2 rounded-full font-medium text-xs transition-all bg-[#f5b21a] text-white hover:bg-[#d99b15] hover:shadow-lg transform hover:-translate-y-0.5"
                  >
                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    {__("Koop nu")}
                  </a>
                  <a
                    href="https://www.gatosports.com"
                    class="flex-1 inline-flex items-center justify-center px-3 py-2 rounded-full font-medium text-xs transition-all border-2 border-[#f5b21a] text-[#f5b21a] hover:bg-[#fef3dc] hover:border-[#d99b15] hover:text-[#d99b15] hover:shadow-lg transform hover:-translate-y-0.5"
                  >
                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    {__("Bekijk")}
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
